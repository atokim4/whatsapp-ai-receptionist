# Copy to .env and fill in. Never commit .env.

PORT=3000
# 127.0.0.1 behind a reverse proxy; 0.0.0.0 inside a container
HOST=127.0.0.1
DATABASE_PATH=./data/receptionist.db

# Meta app -> WhatsApp -> Configuration
# Any random string; paste the same value as "Verify token" when you save the webhook URL.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# Meta app -> App settings -> Basic -> App secret (used to check X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
# System user access token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# WhatsApp -> API Setup -> Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_BASE=https://graph.facebook.com
GRAPH_API_VERSION=v24.0
# Approved template sent instead of free text when the 24h customer service window is closed
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_EFFORT=low

# Staff dashboard at /admin (basic auth). Leave ADMIN_PASSWORD empty to disable it; use 8+ characters.
ADMIN_USER=admin
ADMIN_PASSWORD=

# 1 = local demo: /simulator page, outbound messages kept in memory (no Graph API calls),
# WhatsApp values above are not needed, and without ANTHROPIC_API_KEY an offline rule-based model answers.
DEMO_MODE=0

CLINIC_TIMEZONE=Europe/Berlin
RATE_LIMIT_PER_MINUTE=8
